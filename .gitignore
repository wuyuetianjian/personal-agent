.DS_Store

# Local agent/editor state
.agents/
.codex/
.cursor/*
!.cursor/skills/
!.cursor/skills/**
.continue/
.claude/
CLAUDE.md

# Runtime and temporary output
tmp/
temp/
*.log
/data/
/bin/
/dist/

# Project documentation generated from handoff packs.
# Existing tracked docs stay tracked; allow P14 release docs to be added.
/docs/*
!/docs/p14_ga_release_requirements.md
!/docs/release/
/docs/release/*
!/docs/release/*.md
!/docs/projdocs/
/docs/projdocs/*
!/docs/projdocs/task/
/docs/projdocs/task/*
!/docs/projdocs/task/P14.md

# Browser automation local-only material
browser-profiles/
profiles/
cookies/
sessions/

# TypeScript workspace build/cache
node_modules/
packages/*/dist/
apps/*/dist/
*.tsbuildinfo

# Generated embedded Web client, rebuilt explicitly by make web-assets
internal/webui/dist/*
!internal/webui/dist/placeholder.txt
